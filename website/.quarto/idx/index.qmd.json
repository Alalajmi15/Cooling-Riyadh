o\">\n\nCivil engineer and graduate student in the\n<strong>Master of Urban Spatial Analytics (MUSA)</strong>\nprogram at the\n<strong>University of Pennsylvania</strong>,\nwith approximately six years of professional experience across infrastructure,\nurban development, project controls, and quality engineering projects in\nSaudi Arabia.\n\n<br><br>\n\nAcademic and professional interests include\n<strong>smart cities, geospatial data science, urban analytics,\nand AI-enabled urban decision-making</strong>.\n\n</div>\n\n\n<div class=\"author-facts\">\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Graduate Program</span>\n<span class=\"fact-value\">\nMUSA · University of Pennsylvania\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Bachelor's Degree</span>\n<span class=\"fact-value\">\nB.S. Civil Engineering · Texas A&amp;M University\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Professional Background</span>\n<span class=\"fact-value\">\nWSP · Green Riyadh<br>\nBechtel · NEOM\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Certifications</span>\n<span class=\"fact-value\">\nPMP · PMI-RMP · P3O Foundation\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Focus Areas</span>\n<span class=\"fact-value\">\nSmart Cities · GIS<br>\nUrban Analytics · AI\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Current Project</span>\n<span class=\"fact-value\">\nCooling Riyadh\n</span>\n</div>\n\n\n</div>\n\n</div>\n\n\n<div class=\"info-card project-card\">\n\n\n<div class=\"project-heading\">\n\n<h1>Cooling Riyadh</h1>\n\n<div class=\"project-subtitle\">\nMapping Urban Heat and Greening Priorities in Riyadh:\nA Geospatial Data Science Approach\n</div>\n\n</div>\n\n\n<div class=\"project-divider\"></div>\n\n\n<div class=\"project-description\">\n\nCooling Riyadh is a geospatial data science project examining the spatial\nrelationship between urban heat, vegetation, population exposure, and the\nbuilt environment across Riyadh. The project integrates Landsat satellite\nimagery, WorldPop population estimates, Microsoft Building Footprints, and\nspatial clustering to identify areas that may warrant further evaluation for\nurban greening interventions.\n\n</div>\n\n\n<div class=\"project-tags\">\n\n<span class=\"project-tag\">Landsat LST</span>\n<span class=\"project-tag\">NDVI</span>\n<span class=\"project-tag\">WorldPop</span>\n<span class=\"project-tag\">Building Footprints</span>\n<span class=\"project-tag\">K-Means</span>\n<span class=\"project-tag\">Priority Screening</span>\n\n</div>\n\n\n<h3 class=\"glance-title\">\nProject at a Glance\n</h3>\n\n\n<div class=\"glance-grid\">\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4</span>\n<span class=\"glance-label\">Core Data Sources</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4,700</span>\n<span class=\"glance-label\">Analysis Grid Cells</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">5</span>\n<span class=\"glance-label\">Urban Cluster Profiles</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">500 m</span>\n<span class=\"glance-label\">Spatial Analysis Grid</span>\n</div>\n\n\n</div>\n\n</div>\n\n\n</section>\n\n</div>"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":"auto","echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-di