{"markdown":{"yaml":{"page-layout":"full"},"containsRefs":false,"markdown":"\n\n<style>\n\n/* =========================================================\n   PAGE WRAPPER\n========================================================= */\n\n.home-wrap {\n  position: relative;\n  left: 50%;\n  transform: translateX(-50%);\n  width: min(1380px, 96vw);\n  box-sizing: border-box;\n}\n\n/* Hide any automatic Quarto page title */\n.quarto-title-block,\n#title-block-header {\n  display: none !important;\n}\n\n/* =========================================================\n   PAGE TITLE\n========================================================= */\n\n.home-page-title {\n  width: 100%;\n  margin: 2rem auto 1.6rem auto;\n  text-align: center;\n\n  font-family: Palatino, Georgia, serif;\n  font-size: 2.8rem;\n  line-height: 1.1;\n  font-weight: 700;\n\n  color: #174D38;\n}\n\n/* =========================================================\n   HERO BANNER\n========================================================= */\n\n.hero-section {\n  width: min(1120px, 92vw);\n  margin: 0 auto 2.8rem auto;\n}\n\n.hero-banner {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  border-radius: 18px;\n  box-shadow: 0 14px 34px rgba(23, 77, 56, 0.12);\n}\n\n/* =========================================================\n   MAIN INTRO GRID\n========================================================= */\n\n.intro-grid {\n  width: min(1180px, 94vw);\n  margin: 0 auto 3.2rem auto;\n  display: grid;\n  grid-template-columns: 0.92fr 1.18fr;\n  gap: 1.7rem;\n  align-items: start;\n}\n\n/* =========================================================\n   SHARED CARDS\n========================================================= */\n\n.info-card {\n  background: #FAF7F0;\n  border: 1px solid #E3D6B8;\n  border-radius: 18px;\n  box-shadow: 0 12px 28px rgba(23, 77, 56, 0.07);\n}\n\n/* =========================================================\n   AUTHOR\n========================================================= */\n\n.author-card {\n  padding: 1.7rem 1.5rem 1.45rem 1.5rem;\n}\n\n.author-top {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n\n.profile-photo-frame {\n  flex: 0 0 auto;\n  width: 118px;\n  height: 118px;\n  position: relative;\n  overflow: hidden;\n  border-radius: 50%;\n  background: #F1E8D5;\n  border: 4px solid #F1E8D5;\n  outline: 2px solid #C5A45A;\n  outline-offset: 4px;\n  box-shadow: 0 8px 18px rgba(23, 77, 56, 0.14);\n}\n\n.profile-photo {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n\n  object-position: center 7%;\n  transform: scale(1.52);\n  transform-origin: 50% 7%;\n}\n\n.author-title h2 {\n  margin: 0 0 0.28rem 0;\n  font-family: Palatino, Georgia, serif;\n  font-size: 2rem;\n  line-height: 1.05;\n  color: #174D38;\n}\n\n.author-role {\n  color: #B39256;\n  font-size: 0.95rem;\n  line-height: 1.5;\n  font-weight: 700;\n}\n\n.author-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1rem 0 1.1rem 0;\n}\n\n.author-bio {\n  color: #3A3A3A;\n  font-size: 0.95rem;\n  line-height: 1.8;\n  margin-bottom: 1rem;\n}\n\n.author-bio strong {\n  color: #174D38;\n}\n\n/* =========================================================\n   AUTHOR FACTS\n========================================================= */\n\n.author-facts {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.fact-box {\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  border-radius: 10px;\n  padding: 0.75rem 0.8rem;\n}\n\n.fact-label {\n  display: block;\n  margin-bottom: 0.25rem;\n  color: #6E7C72;\n  font-size: 0.65rem;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.fact-value {\n  display: block;\n  color: #174D38;\n  font-size: 0.82rem;\n  line-height: 1.45;\n  font-weight: 700;\n}\n\n/* =========================================================\n   PROJECT\n========================================================= */\n\n.project-card {\n  padding: 1.8rem 1.7rem 1.6rem 1.7rem;\n}\n\n.project-heading {\n  margin-bottom: 1rem;\n}\n\n.project-heading h1 {\n  margin: 0;\n  font-family: Palatino, Georgia, serif;\n  font-size: 3rem;\n  line-height: 1.05;\n  color: #174D38;\n}\n\n.project-subtitle {\n  margin-top: 0.65rem;\n  font-family: Palatino, Georgia, serif;\n  font-size: 1.33rem;\n  line-height: 1.4;\n  color: #C5A45A;\n  font-weight: 700;\n}\n\n.project-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1.2rem 0 1.2rem 0;\n}\n\n.project-description {\n  color: #3A3A3A;\n  font-size: 1rem;\n  line-height: 1.85;\n  margin-bottom: 1.15rem;\n}\n\n.project-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 1.6rem;\n}\n\n.project-tag {\n  display: inline-block;\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  color: #174D38;\n  border-radius: 999px;\n  padding: 0.45rem 0.8rem;\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n/* =========================================================\n   PROJECT AT A GLANCE\n========================================================= */\n\n.glance-title {\n  margin: 0 0 0.9rem 0;\n  font-family: Palatino, Georgia, serif;\n  color: #174D38;\n  font-size: 1.9rem;\n  font-weight: 700;\n}\n\n.glance-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n}\n\n.glance-card {\n  background: #FFFFFF;\n  border: 1px solid #E3D6B8;\n  border-radius: 12px;\n  padding: 1rem 0.85rem;\n  text-align: center;\n}\n\n.glance-number {\n  display: block;\n  color: #174D38;\n  font-size: 1.65rem;\n  font-weight: 700;\n  margin-bottom: 0.25rem;\n}\n\n.glance-label {\n  display: block;\n  color: #65766D;\n  font-size: 0.86rem;\n  line-height: 1.4;\n}\n\n/* =========================================================\n   RESPONSIVE\n========================================================= */\n\n@media (max-width: 1080px) {\n\n  .intro-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.5rem;\n  }\n}\n\n@media (max-width: 760px) {\n\n  .author-top {\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n\n  .author-facts {\n    grid-template-columns: 1fr;\n  }\n\n  .glance-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .home-page-title {\n    font-size: 2.3rem;\n  }\n}\n\n@media (max-width: 520px) {\n\n  .glance-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.15rem;\n  }\n\n  .project-subtitle {\n    font-size: 1.08rem;\n  }\n}\n\n</style>\n\n\n<div class=\"home-wrap\">\n\n\n<div class=\"home-page-title\">\nCooling Riyadh\n</div>\n\n\n<section class=\"hero-section\">\n\n<img\n  src=\"assets/images/portfolio-banner.jpeg\"\n  class=\"hero-banner\"\n  alt=\"Cooling Riyadh project banner\">\n\n</section>\n\n\n<section class=\"intro-grid\">\n\n\n<div class=\"info-card author-card\">\n\n<div class=\"author-top\">\n\n<div class=\"profile-photo-frame\">\n\n<img\n  src=\"assets/images/profile/alhaylam_profile.jpg\"\n  class=\"profile-photo\"\n  alt=\"Alhaylam Fahad Alajmi\">\n\n</div>\n\n\n<div class=\"author-title\">\n\n<h2>Alhaylam Fahad Alajmi</h2>\n\n<div class=\"author-role\">\nCivil Engineer<br>\nUrban Spatial Analytics Graduate Student\n</div>\n\n</div>\n\n</div>\n\n\n<div class=\"author-divider\"></div>\n\n\n<div class=\"author-bio\">\n\nCivil engineer and graduate student in the\n<strong>Master of Urban Spatial Analytics (MUSA)</strong>\nprogram at the\n<strong>University of Pennsylvania</strong>,\nwith approximately six years of professional experience across infrastructure,\nurban development, project controls, and quality engineering projects in\nSaudi Arabia.\n\n<br><br>\n\nAcademic and professional interests include\n<strong>smart cities, geospatial data science, urban analytics,\nand AI-enabled urban decision-making</strong>.\n\n</div>\n\n\n<div class=\"author-facts\">\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Graduate Program</span>\n<span class=\"fact-value\">\nMUSA · University of Pennsylvania\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Bachelor's Degree</span>\n<span class=\"fact-value\">\nB.S. Civil Engineering · Texas A&amp;M University\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Professional Background</span>\n<span class=\"fact-value\">\nWSP · Green Riyadh<br>\nBechtel · NEOM\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Certifications</span>\n<span class=\"fact-value\">\nPMP · PMI-RMP · P3O Foundation\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Focus Areas</span>\n<span class=\"fact-value\">\nSmart Cities · GIS<br>\nUrban Analytics · AI\n</span>\n</div>\n\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">Current Project</span>\n<span class=\"fact-value\">\nCooling Riyadh\n</span>\n</div>\n\n\n</div>\n\n</div>\n\n\n<div class=\"info-card project-card\">\n\n\n<div class=\"project-heading\">\n\n<h1>Cooling Riyadh</h1>\n\n<div class=\"project-subtitle\">\nMapping Urban Heat and Greening Priorities in Riyadh:\nA Geospatial Data Science Approach\n</div>\n\n</div>\n\n\n<div class=\"project-divider\"></div>\n\n\n<div class=\"project-description\">\n\nCooling Riyadh is a geospatial data science project examining the spatial\nrelationship between urban heat, vegetation, population exposure, and the\nbuilt environment across Riyadh. The project integrates Landsat satellite\nimagery, WorldPop population estimates, Microsoft Building Footprints, and\nspatial clustering to identify areas that may warrant further evaluation for\nurban greening interventions.\n\n</div>\n\n\n<div class=\"project-tags\">\n\n<span class=\"project-tag\">Landsat LST</span>\n<span class=\"project-tag\">NDVI</span>\n<span class=\"project-tag\">WorldPop</span>\n<span class=\"project-tag\">Building Footprints</span>\n<span class=\"project-tag\">K-Means</span>\n<span class=\"project-tag\">Priority Screening</span>\n\n</div>\n\n\n<h3 class=\"glance-title\">\nProject at a Glance\n</h3>\n\n\n<div class=\"glance-grid\">\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4</span>\n<span class=\"glance-label\">Core Data Sources</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4,700</span>\n<span class=\"glance-label\">Analysis Grid Cells</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">5</span>\n<span class=\"glance-label\">Urban Cluster Profiles</span>\n</div>\n\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">500 m</span>\n<span class=\"glance-label\">Spatial Analysis Grid</span>\n</div>\n\n\n</div>\n\n</div>\n\n\n</section>\n\n</div>","srcMarkdownNoYaml":"\n\n<style>\n\n/* =========================================================\n   PAGE WRAPPER\n========================================================= */\n\n.home-wrap {\n  position: relative;\n  left: 50%;\n  transform: translateX(-50%);\n  width: min(1380px, 96vw);\n  box-sizing: border-box;\n}\n\n/* Hide any automatic Quarto page title */\n.quarto-title-block,\n#title-block-header {\n  display: none !important;\n}\n\n/* =========================================================\n   PAGE TITLE\n========================================================= */\n\n.home-page-title {\n  width: 100%;\n  margin: 2rem auto 1.6rem auto;\n  text-align: center;\n\n  font-family: Palatino, Georgia, serif;\n  font-size: 2.8rem;\n  line-height: 1.1;\n  font-weight: 700;\n\n  color: #174D38;\n}\n\n/* =========================================================\n   HERO BANNER\n========================================================= */\n\n.hero-section {\n  width: min(1120px, 92vw);\n  margin: 0 auto 2.8rem auto;\n}\n\n.hero-banner {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  border-radius: 18px;\n  box-shadow: 0 14px 34px rgba(23, 77, 56, 0.12);\n}\n\n/* =========================================================\n   MAIN INTRO GRID\n==================