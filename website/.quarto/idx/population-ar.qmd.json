;\n  height: auto;\n  left: 0;\n  top: -185px;\n  object-fit: contain;\n  opacity: 0.18;\n  margin: 0;\n  padding: 0;\n}\n\nbody.arabic-page .navbar-container {\n  direction: rtl !important;\n}\n\nbody.arabic-page .navbar-nav {\n  direction: rtl !important;\n}\n\nbody.arabic-page .navbar-brand {\n  margin-right: 0 !important;\n  margin-left: 34px !important;\n}\n\nbody.arabic-page .navbar-brand img {\n  margin-right: 0 !important;\n  margin-left: 14px !important;\n}\n\n@media (max-width: 1000px) {\n\n  .navbar {\n    min-height: 76px !important;\n  }\n\n  .navbar-logo,\n  .navbar-brand img {\n    width: 62px !important;\n    height: 62px !important;\n    max-height: 62px !important;\n  }\n\n  .najdi-line-banner {\n    height: 150px;\n  }\n\n  .najdi-line-banner img {\n    top: -140px;\n    opacity: 0.17;\n  }\n}\n\n@media (max-width: 600px) {\n\n  .navbar {\n    min-height: 68px !important;\n  }\n\n  .navbar-logo,\n  .navbar-brand img {\n    width: 52px !important;\n    height: 52px !important;\n    max-height: 52px !important;\n  }\n\n  .najdi-line-banner {\n    height: 110px;\n  }\n\n  .najdi-line-banner img {\n    top: -85px;\n    opacity: 0.16;\n  }\n}\n\n</style>\n\n<div class=\"najdi-line-banner\">\n  <img\n    src=\"assets/images/najdi-line-banner.png\"\n    alt=\"Traditional Saudi architectural line illustration\">\n</div>\n"}],"include-after-body":[{"text":"<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  const path = window.location.pathname.toLowerCase();\n\n  const isArabic =\n    path.endsWith(\"index-ar.html\") ||\n    path.endsWith(\"urban-heat-ar.html\") ||\n    path.endsWith(\"vegetation-buildings-ar.html\") ||\n    path.endsWith(\"population-ar.html\") ||\n    path.endsWith(\"priority-ar.html\") ||\n    path.endsWith(\"methods-ar.html\");\n\n  if (!isArabic) return;\n\n  document.body.classList.add(\"arabic-page\");\n  document.documentElement.setAttribute(\"lang\", \"ar\");\n  document.documentElement.setAttribute(\"dir\", \"rtl\");\n\n  const links = document.querySelectorAll(\".navbar a.nav-link\");\n\n  links.forEach(function(link) {\n\n    const href = link.getAttribute(\"href\") || \"\";\n\n    if (href.endsWith(\"index.html\")) {\n      link.textContent = \"الرئيسية\";\n      link.setAttribute(\"href\", \"index-ar.html\");\n    }\n\n    else if (href.includes(\"urban-heat\")) {\n      link.textContent = \"الحرارة الحضرية\";\n      link.setAttribute(\"href\", \"urban-heat-ar.html\");\n    }\n\n    else if (href.includes(\"vegetation-buildings\")) {\n      link.textContent = \"الغطاء النباتي والمباني\";\n      link.setAttribute(\"href\", \"vegetation-buildings-ar.html\");\n    }\n\n    else if (href.includes(\"population\")) {\n      link.textContent = \"التعرض السكاني\";\n      link.setAttribute(\"href\", \"population-ar.html\");\n    }\n\n    else if (href.includes(\"priority\")) {\n      link.textContent = \"الذكاء الاصطناعي ومناطق الأولوية\";\n      link.setAttribute(\"href\", \"priority-ar.html\");\n    }\n\n    else if (href.includes(\"methods\")) {\n      link.textContent = \"المنهجية والبيانات\";\n      link.setAttribute(\"href\", \"methods-ar.html\");\n    }\n\n    else if (href.includes(\"index-ar\")) {\n\n      link.textContent = \"English\";\n\n      if (path.endsWith(\"urban-heat-ar.html\")) {\n        link.setAttribute(\"href\", \"urban-heat.html\");\n      }\n\n      else if (path.endsWith(\"vegetation-buildings-ar.html\")) {\n        link.setAttribute(\"href\", \"vegetation-buildings.html\");\n      }\n\n      else if (path.endsWith(\"population-ar.html\")) {\n        link.setAttribute(\"href\", \"population.html\");\n      }\n\n      else if (path.endsWith(\"priority-ar.html\")) {\n        link.setAttribute(\"href\", \"priority.html\");\n      }\n\n      else if (path.endsWith(\"methods-ar.html\")) {\n        link.setAttribute(\"href\", \"methods.html\");\n      }\n\n      else {\n        link.setAttribute(\"href\", \"index.html\");\n      }\n    }\n\n  });\n\n});\n</script>\n"}],"output-file":"population-ar.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launch-dev-container-title":"Launch Dev Container","launch-binder-title":"Launch Binder","article-notebook-label":"Article Notebook","notebook-preview-download":"Download Notebook","notebook-preview-download-src":"Download Source","notebook-preview-back":"Back to Article","manuscript-meca-bundle":"MECA Bundle","section-title-abstract":"Abstract","section-title-appendices":"Appendices","section-title-footnotes":"Footnotes","section-title-references":"References","section-title-reuse":"Reuse","section-title-copyright":"Copyright","section-title-citation":"Citation","appendix-attribution-cite-as":"For attribution, please cite this work as:","appendix-attribution-bibtex":"BibTeX citation:","appendix-view-license":"View License","title-block-author-single":"Author","title-block-author-plural":"Authors","title-block-affiliation-single":"Affiliation","title-block-affiliation-plural":"Affiliations","title-block-published":"Published","title-block-modified":"Modified","title-block-keywords":"Keywords","callout-tip-title":"Tip","callout-note-title":"Note","callout-warning-title":"Warning","callout-important-title":"Important","callout-caution-title":"Caution","code-summary":"Code","code-tools-menu-caption":"Code","code-tools-show-all-code":"Show All Code","code-tools-hide-all-code":"Hide All Code","code-tools-view-source":"View Source","code-tools-source-code":"Source Code","tools-share":"Share","tools-download":"Download","code-line":"Line","code-lines":"Lines","copy-button-tooltip":"Copy to Clipboard","copy-button-tooltip-success":"Copied!","repo-action-links-edit":"Edit this page","repo-action-links-source":"View source","repo-action-links-issue":"Report