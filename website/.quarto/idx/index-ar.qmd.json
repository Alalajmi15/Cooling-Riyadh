olor: #174D38;\n}\n\n.author-role {\n  color: #B39256;\n  font-size: 0.95rem;\n  line-height: 1.7;\n  font-weight: 700;\n}\n\n.author-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1rem 0 1.1rem 0;\n}\n\n.author-bio {\n  color: #3A3A3A;\n  font-size: 0.95rem;\n  line-height: 1.9;\n  margin-bottom: 1rem;\n  text-align: right;\n}\n\n.author-bio strong {\n  color: #174D38;\n}\n\n/* =========================================================\n   AUTHOR FACTS\n========================================================= */\n\n.author-facts {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.fact-box {\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  border-radius: 10px;\n  padding: 0.75rem 0.8rem;\n  text-align: right;\n}\n\n.fact-label {\n  display: block;\n  margin-bottom: 0.25rem;\n  color: #6E7C72;\n  font-size: 0.68rem;\n}\n\n.fact-value {\n  display: block;\n  color: #174D38;\n  font-size: 0.82rem;\n  line-height: 1.6;\n  font-weight: 700;\n}\n\n/* =========================================================\n   PROJECT CARD\n========================================================= */\n\n.project-card {\n  padding: 1.8rem 1.7rem 1.6rem 1.7rem;\n  text-align: right;\n}\n\n.project-heading {\n  margin-bottom: 1rem;\n}\n\n.project-heading h1 {\n  margin: 0;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 2.7rem;\n  line-height: 1.25;\n  color: #174D38;\n}\n\n.project-subtitle {\n  margin-top: 0.65rem;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 1.25rem;\n  line-height: 1.7;\n  color: #C5A45A;\n  font-weight: 700;\n}\n\n.project-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1.2rem 0;\n}\n\n.project-description {\n  color: #3A3A3A;\n  font-size: 1rem;\n  line-height: 1.95;\n  margin-bottom: 1.15rem;\n}\n\n.project-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 1.6rem;\n  justify-content: flex-start;\n}\n\n.project-tag {\n  display: inline-block;\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  color: #174D38;\n  border-radius: 999px;\n  padding: 0.45rem 0.8rem;\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n/* =========================================================\n   GLANCE\n========================================================= */\n\n.glance-title {\n  margin: 0 0 0.9rem 0;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  color: #174D38;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.glance-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n  direction: ltr;\n}\n\n.glance-card {\n  background: #FFFFFF;\n  border: 1px solid #E3D6B8;\n  border-radius: 12px;\n  padding: 1rem 0.85rem;\n  text-align: center;\n  direction: rtl;\n}\n\n.glance-number {\n  display: block;\n  color: #174D38;\n  font-size: 1.65rem;\n  font-weight: 700;\n  margin-bottom: 0.25rem;\n}\n\n.glance-label {\n  display: block;\n  color: #65766D;\n  font-size: 0.86rem;\n  line-height: 1.6;\n}\n\n/* =========================================================\n   RESPONSIVE\n========================================================= */\n\n@media (max-width: 1080px) {\n\n  .intro-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.4rem;\n  }\n}\n\n@media (max-width: 760px) {\n\n  .author-top {\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n\n  .author-title {\n    text-align: center;\n  }\n\n  .author-facts {\n    grid-template-columns: 1fr;\n  }\n\n  .glance-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .home-page-title {\n    font-size: 2.3rem;\n  }\n}\n\n@media (max-width: 520px) {\n\n  .glance-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.05rem;\n  }\n\n  .project-subtitle {\n    font-size: 1.05rem;\n  }\n}\n\n</style>\n\n<div class=\"home-wrap\">\n\n<div class=\"home-page-title\">\nتبريد الرياض\n</div>\n\n<section class=\"hero-section\">\n\n<img\n  src=\"assets/images/portfolio-banner.jpeg\"\n  class=\"hero-banner\"\n  alt=\"مشروع تبريد الرياض\">\n\n</section>\n\n<section class=\"intro-grid\">\n\n<div class=\"info-card author-card\">\n\n<div class=\"author-top\">\n\n<div class=\"profile-photo-frame\">\n\n<img\n  src=\"assets/images/profile/alhaylam_profile.jpg\"\n  class=\"profile-photo\"\n  alt=\"الهيلم فهد العجمي\">\n\n</div>\n\n<div class=\"author-title\">\n\n<h2>الهيلم فهد العجمي</h2>\n\n<div class=\"author-role\">\nمهندس مدني<br>\nطالب دراسات عليا في التحليلات المكانية الحضرية\n</div>\n\n</div>\n\n</div>\n\n<div class=\"author-divider\"></div>\n\n<div class=\"author-bio\">\n\nمهندس مدني وطالب دراسات عليا في برنامج\n<strong>ماجستير التحليلات المكانية الحضرية (MUSA)</strong>\nفي\n<strong>جامعة بنسلفانيا</strong>،\nمع خبرة مهنية تقارب ست سنوات في مشاريع البنية التحتية، والتطوير الحضري،\nوضبط المشاريع، وهندسة الجودة في المملكة العربية السعودية.\n\n<br><br>\n\nتركز اهتماماتي الأكاديمية والمهنية على\n<strong>المدن الذكية، وعلوم البيانات الجغرافية المكانية،\nوالتحليلات الحضرية، واستخدام الذكاء الاصطناعي لدعم القرارات الحضرية</strong>.\n\n</div>\n\n<div class=\"author-facts\">\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">برنامج الدراسات العليا</span>\n<span class=\"fact-value\">MUSA · جامعة بنسلفانيا</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">درجة البكالوريوس</span>\n<span class=\"fact-value\">\nبكالوريوس الهندسة المدنية · جامعة تكساس A&amp;M\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">الخبرة المهنية</span>\n<span class=\"fact-value\">\nWSP · الرياض الخضراء<br>\nBechtel · نيوم\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">الشهادات المهنية</span>\n<span class=\"fact-value\">\nPMP · PMI-RMP · P3O Foundation\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">مجالات الاهتمام</span>\n<span class=\"fact-value\">\nالمدن الذكية · GIS<br>\nالتحليلات الحضرية · الذكاء الاصطناعي\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">المشروع الحالي</span>\n<span class=\"fact-value\">\nتبريد الرياض\n</span>\n</div>\n\n</div>\n\n</div>\n\n<div class=\"info-card project-card\">\n\n<div class=\"project-heading\">\n\n<h1>تبريد الرياض</h1>\n\n<div class=\"project-subtitle\">\nرسم خرائط الحرارة الحضرية وأولويات التخضير في مدينة الرياض:\nمنهج قائم على علوم البيانات الجغرافية المكانية\n</div>\n\n</div>\n\n<div class=\"project-divider\"></div>\n\n<div class=\"project-description\">\n\nمشروع <strong>تبريد الرياض</strong> هو مشروع في علوم البيانات الجغرافية المكانية\nيدرس العلاقة المكانية بين حرارة سطح الأرض، والغطاء النباتي، والتعرض السكاني،\nوالبيئة المبنية في مدينة الرياض.\n\nيجمع المشروع بين صور الأقمار الصناعية من Landsat، وتقديرات السكان من WorldPop،\nوبصمات المباني من Microsoft، والتحليل المكاني، والتعلم الآلي، والخرائط التفاعلية\nلتحديد المناطق التي قد تستحق مزيدًا من الدراسة عند تقييم تدخلات التخضير الحضري\nوالحد من آثار الحرارة.\n\n</div>\n\n<div class=\"project-tags\">\n\n<span class=\"project-tag\">حرارة سطح الأرض LST</span>\n<span class=\"project-tag\">مؤشر NDVI</span>\n<span class=\"project-tag\">WorldPop</span>\n<span class=\"project-tag\">بصمات المباني</span>\n<span class=\"project-tag\">K-Means</span>\n<span class=\"project-tag\">فحص الأولويات</span>\n\n</div>\n\n<h3 class=\"glance-title\">\nالمشروع في أرقام\n</h3>\n\n<div class=\"glance-grid\">\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4</span>\n<span class=\"glance-label\">مصادر بيانات رئيسية</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4,700</span>\n<span class=\"glance-label\">خلية تحليل مكانية</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">5</span>\n<span class=\"glance-label\">أنماط حضرية ناتجة عن التجميع</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">500 م</span>\n<span class=\"glance-label\">حجم شبكة التحليل المكاني</span>\n</div>\n\n</div>\n\n</div>\n\n</section>\n\n</div>"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":"auto","echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":false,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["styles.css"],"toc":true,"include-before-body":[{"text":"<style>\n\n.navbar {\n  min-height: 86px !important;\n}\n\n.navbar-container {\n  justify-content: flex-start !important;\n}\n\n.navbar-brand {\n  display: flex !important;\n  align-items: center !important;\n  margin-right: 34px !important;\n}\n\n.navbar-logo,\n.navbar-brand img {\n  width: 72px !important;\n  height: 72px !important;\n  max-height: 72px !important;\n  object-fit: contain !important;\n  margin-right: 14px !important;\n}\n\n.navbar-brand-container {\n  flex-shrink: 0 !important;\n}\n\n.navbar-nav {\n  margin-left: 0 !important;\n  justify-content: flex-start !important;\n  gap: 8px;\n}\n\n.navbar .nav-link {\n  white-space: nowrap;\n}\n\n.najdi-line-banner {\n  width: 100%;\n  height: 185px;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: #ffffff;\n  position: relative;\n}\n\n.najdi-line-banner img {\n  position: absolute;\n  width: 100%;\n  height: auto;\n  left: 0;\n  top: -185px;\n  object-fit: contain;\n  opacity: 0.18;\n  margin: 0;\n  padding: 0;\n}\n\nbody.arabic-page .navbar-container {\n  direction: rtl !important;\n}\n\nbody.arabic-page .navbar-nav {\n  direction: rtl !important;\n}\n\nbody.arabic-page .navbar-brand {\n  margin-right: 0 !important;\n  margin-left: 34px !important;\n}\n\nbody.arabic-page .navbar-brand img {\n  margin-right: 0 !important;\n  margin-left: 14px !important;\n}\n\n@media (max-width: 1000px) {\n\n  .navbar {\n    min-height: 76px !important;\n  }\n\n  .navbar-logo,\n  .navbar-brand img {\n    width: 62px !important;\n    height: 62px !important;\n    max-height: 62px !important;\n  }\n\n  .najdi-line-banner {\n    height: 150px;\n  }\n\n  .najdi-line-banner img {\n    top: -140px;\n    opacity: 0.17;\n  }\n}\n\n@media (max-width: 600px) {\n\n  .navbar {\n    min-height: 68px !important;\n  }\n\n  .navbar-logo,\n  .navbar-brand img {\n    width: 52px !important;\n    height: 52px !important;\n    max-height: 52px !important;\n  }\n\n  .najdi-line-banner {\n    height: 110px;\n  }\n\n  .najdi-line-banner img {\n    top: -85px;\n    opacity: 0.16;\n  }\n}\n\n</style>\n\n<div class=\"najdi-line-banner\">\n  <img\n    src=\"assets/images/najdi-line-banner.png\"\n    alt=\"Traditional Saudi architectural line illustration\">\n</div>\n"}],"include-after-body":[{"text":"<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  const path = window.location.pathname.toLowerCase();\n\n  const isArabic =\n    path.endsWith(\"index-ar.html\") ||\n    path.endsWith(\"urban-heat-ar.html\") ||\n    path.endsWith(\"vegetation-buildings-ar.html\") ||\n    path.endsWith(\"population-ar.html\") ||\n    path.endsWith(\"priority-ar.html\") ||\n    path.endsWith(\"methods-ar.html\");\n\n  if (!isArabic) return;\n\n  document.body.classList.add(\"arabic-page\");\n  document.documentElement.setAttribute(\"lang\", \"ar\");\n  document.documentElement.setAttribute(\"dir\", \"rtl\");\n\n  const links = document.querySelectorAll(\".navbar a.nav-link\");\n\n  links.forEach(function(link) {\n\n    const href = link.getAttribute(\"href\") || \"\";\n\n    if (href.endsWith(\"index.html\")) {\n      link.textContent = \"الرئيسية\";\n      link.setAttribute(\"href\", \"index-ar.html\");\n    }\n\n    else if (href.includes(\"urban-heat\")) {\n      link.textContent = \"الحرارة الحضرية\";\n      link.setAttribute(\"href\", \"urban-heat-ar.html\");\n    }\n\n    else if (href.includes(\"vegetation-buildings\")) {\n      link.textContent = \"الغطاء النباتي والمباني\";\n      link.setAttribute(\"href\", \"vegetation-buildings-ar.html\");\n    }\n\n    else if (href.includes(\"population\")) {\n      link.textContent = \"التعرض السكاني\";\n      link.setAttribute(\"href\", \"population-ar.html\");\n    }\n\n    else if (href.includes(\"priority\")) {\n      link.textContent = \"الذكاء الاصطناعي ومناطق الأولوية\";\n      link.setAttribute(\"href\", \"priority-ar.html\");\n    }\n\n    else if (href.includes(\"methods\")) {\n      link.textContent = \"المنهجية والبيانات\";\n      link.setAttribute(\"href\", \"methods-ar.html\");\n    }\n\n    else if (href.includes(\"index-ar\")) {\n\n      link.textContent = \"English\";\n\n      if (path.endsWith(\"urban-heat-ar.html\")) {\n        link.setAttribute(\"href\", \"urban-heat.html\");\n      }\n\n      else if (path.endsWith(\"vegetation-buildings-ar.html\")) {\n        link.setAttribute(\"href\", \"vegetation-buildings.html\");\n      }\n\n      else if (path.endsWith(\"population-ar.html\")) {\n        link.setAttribute(\"href\", \"population.html\");\n      }\n\n      else if (path.endsWith(\"priority-ar.html\")) {\n        link.setAttribute(\"href\", \"priority.html\");\n      }\n\n      else if (path.endsWith(\"methods-ar.html\")) {\n        link.setAttribute(\"href\", \"methods.html\");\n      }\n\n      else {\n        link.setAttribute(\"href\", \"index.html\");\n      }\n    }\n\n  });\n\n});\n</script>\n"}],"output-file":"index-ar.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launch-dev-container-title":"Launch Dev Container","launch-binder-title":"Launch Binder","article-notebook-label":"Article Notebook","notebook-preview-download":"Download Notebook","notebook-preview-download-src":"Download Source","notebook-preview-back":"Back to Article","manuscript-meca-bundle":"MECA Bundle","section-title-abstract":"Abstract","section-title-appendices":"Appendices","section-title-footnotes":"Footnotes","section-title-references":"References","section-title-reuse":"Reuse","section-title-copyright":"Copyright","section-title-citation":"Citation","appendix-attribution-cite-as":"For attribution, please cite this work as:","appendix-attribution-bibtex":"BibTeX citation:","appendix-view-license":"View License","title-block-author-single":"Author","title-block-author-plural":"Authors","title-block-affiliation-single":"Affiliation","title-block-affiliation-plural":"Affiliations","title-block-published":"Published","title-block-modified":"Modified","title-block-keywords":"Keywords","callout-tip-title":"Tip","callout-note-title":"Note","callout-warning-title":"Warning","callout-important-title":"Important","callout-caution-title":"Caution","code-summary":"Code","code-tools-menu-caption":"Code","code-tools-show-all-code":"Show All Code","code-tools-hide-all-code":"Hide All Code","code-tools-view-source":"View Source","code-tools-source-cod