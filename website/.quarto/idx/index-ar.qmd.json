{"markdown":{"yaml":{"page-layout":"full","lang":"ar","dir":"rtl"},"containsRefs":false,"markdown":"\n\n<style>\n\nhtml,\nbody {\n  direction: rtl;\n}\n\nbody {\n  text-align: right;\n}\n\n.quarto-title-block,\n#title-block-header {\n  display: none !important;\n}\n\n/* =========================================================\n   MAIN WRAPPER\n========================================================= */\n\n.home-wrap {\n  width: min(1380px, 96vw);\n  margin: 0 auto;\n  box-sizing: border-box;\n}\n\n/* =========================================================\n   PAGE TITLE\n========================================================= */\n\n.home-page-title {\n  width: 100%;\n  margin: 2rem auto 1.6rem auto;\n  text-align: center;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 2.8rem;\n  line-height: 1.25;\n  font-weight: 700;\n  color: #174D38;\n}\n\n/* =========================================================\n   HERO\n========================================================= */\n\n.hero-section {\n  width: min(1120px, 92vw);\n  margin: 0 auto 2.8rem auto;\n  text-align: center;\n}\n\n.hero-banner {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  margin: 0 auto;\n  border-radius: 18px;\n  box-shadow: 0 14px 34px rgba(23, 77, 56, 0.12);\n}\n\n/* =========================================================\n   MAIN GRID\n========================================================= */\n\n.intro-grid {\n  width: min(1180px, 94vw);\n  margin: 0 auto 3.2rem auto;\n  display: grid;\n  grid-template-columns: 0.92fr 1.18fr;\n  gap: 1.7rem;\n  align-items: start;\n\n  /* keep the grid centered normally */\n  direction: ltr;\n}\n\n.author-card,\n.project-card {\n  direction: rtl;\n}\n\n/* =========================================================\n   SHARED CARDS\n========================================================= */\n\n.info-card {\n  background: #FAF7F0;\n  border: 1px solid #E3D6B8;\n  border-radius: 18px;\n  box-shadow: 0 12px 28px rgba(23, 77, 56, 0.07);\n}\n\n/* =========================================================\n   AUTHOR CARD\n========================================================= */\n\n.author-card {\n  padding: 1.7rem 1.5rem 1.45rem 1.5rem;\n}\n\n.author-top {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-bottom: 1rem;\n  direction: rtl;\n}\n\n.profile-photo-frame {\n  flex: 0 0 auto;\n  width: 118px;\n  height: 118px;\n  position: relative;\n  overflow: hidden;\n  border-radius: 50%;\n  background: #F1E8D5;\n  border: 4px solid #F1E8D5;\n  outline: 2px solid #C5A45A;\n  outline-offset: 4px;\n  box-shadow: 0 8px 18px rgba(23, 77, 56, 0.14);\n}\n\n.profile-photo {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center 7%;\n  transform: scale(1.52);\n  transform-origin: 50% 7%;\n}\n\n.author-title {\n  text-align: right;\n}\n\n.author-title h2 {\n  margin: 0 0 0.28rem 0;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 1.85rem;\n  line-height: 1.3;\n  color: #174D38;\n}\n\n.author-role {\n  color: #B39256;\n  font-size: 0.95rem;\n  line-height: 1.7;\n  font-weight: 700;\n}\n\n.author-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1rem 0 1.1rem 0;\n}\n\n.author-bio {\n  color: #3A3A3A;\n  font-size: 0.95rem;\n  line-height: 1.9;\n  margin-bottom: 1rem;\n  text-align: right;\n}\n\n.author-bio strong {\n  color: #174D38;\n}\n\n/* =========================================================\n   AUTHOR FACTS\n========================================================= */\n\n.author-facts {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.fact-box {\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  border-radius: 10px;\n  padding: 0.75rem 0.8rem;\n  text-align: right;\n}\n\n.fact-label {\n  display: block;\n  margin-bottom: 0.25rem;\n  color: #6E7C72;\n  font-size: 0.68rem;\n}\n\n.fact-value {\n  display: block;\n  color: #174D38;\n  font-size: 0.82rem;\n  line-height: 1.6;\n  font-weight: 700;\n}\n\n/* =========================================================\n   PROJECT CARD\n========================================================= */\n\n.project-card {\n  padding: 1.8rem 1.7rem 1.6rem 1.7rem;\n  text-align: right;\n}\n\n.project-heading {\n  margin-bottom: 1rem;\n}\n\n.project-heading h1 {\n  margin: 0;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 2.7rem;\n  line-height: 1.25;\n  color: #174D38;\n}\n\n.project-subtitle {\n  margin-top: 0.65rem;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 1.25rem;\n  line-height: 1.7;\n  color: #C5A45A;\n  font-weight: 700;\n}\n\n.project-divider {\n  height: 1px;\n  background: #DDD6C7;\n  margin: 1.2rem 0;\n}\n\n.project-description {\n  color: #3A3A3A;\n  font-size: 1rem;\n  line-height: 1.95;\n  margin-bottom: 1.15rem;\n}\n\n.project-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 1.6rem;\n  justify-content: flex-start;\n}\n\n.project-tag {\n  display: inline-block;\n  background: #F4EFE5;\n  border: 1px solid #E5DCC8;\n  color: #174D38;\n  border-radius: 999px;\n  padding: 0.45rem 0.8rem;\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n/* =========================================================\n   GLANCE\n========================================================= */\n\n.glance-title {\n  margin: 0 0 0.9rem 0;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  color: #174D38;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.glance-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n  direction: ltr;\n}\n\n.glance-card {\n  background: #FFFFFF;\n  border: 1px solid #E3D6B8;\n  border-radius: 12px;\n  padding: 1rem 0.85rem;\n  text-align: center;\n  direction: rtl;\n}\n\n.glance-number {\n  display: block;\n  color: #174D38;\n  font-size: 1.65rem;\n  font-weight: 700;\n  margin-bottom: 0.25rem;\n}\n\n.glance-label {\n  display: block;\n  color: #65766D;\n  font-size: 0.86rem;\n  line-height: 1.6;\n}\n\n/* =========================================================\n   RESPONSIVE\n========================================================= */\n\n@media (max-width: 1080px) {\n\n  .intro-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.4rem;\n  }\n}\n\n@media (max-width: 760px) {\n\n  .author-top {\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n  }\n\n  .author-title {\n    text-align: center;\n  }\n\n  .author-facts {\n    grid-template-columns: 1fr;\n  }\n\n  .glance-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .home-page-title {\n    font-size: 2.3rem;\n  }\n}\n\n@media (max-width: 520px) {\n\n  .glance-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .project-heading h1 {\n    font-size: 2.05rem;\n  }\n\n  .project-subtitle {\n    font-size: 1.05rem;\n  }\n}\n\n</style>\n\n<div class=\"home-wrap\">\n\n<div class=\"home-page-title\">\nتبريد الرياض\n</div>\n\n<section class=\"hero-section\">\n\n<img\n  src=\"assets/images/portfolio-banner.jpeg\"\n  class=\"hero-banner\"\n  alt=\"مشروع تبريد الرياض\">\n\n</section>\n\n<section class=\"intro-grid\">\n\n<div class=\"info-card author-card\">\n\n<div class=\"author-top\">\n\n<div class=\"profile-photo-frame\">\n\n<img\n  src=\"assets/images/profile/alhaylam_profile.jpg\"\n  class=\"profile-photo\"\n  alt=\"الهيلم فهد العجمي\">\n\n</div>\n\n<div class=\"author-title\">\n\n<h2>الهيلم فهد العجمي</h2>\n\n<div class=\"author-role\">\nمهندس مدني<br>\nطالب دراسات عليا في التحليلات المكانية الحضرية\n</div>\n\n</div>\n\n</div>\n\n<div class=\"author-divider\"></div>\n\n<div class=\"author-bio\">\n\nمهندس مدني وطالب دراسات عليا في برنامج\n<strong>ماجستير التحليلات المكانية الحضرية (MUSA)</strong>\nفي\n<strong>جامعة بنسلفانيا</strong>،\nمع خبرة مهنية تقارب ست سنوات في مشاريع البنية التحتية، والتطوير الحضري،\nوضبط المشاريع، وهندسة الجودة في المملكة العربية السعودية.\n\n<br><br>\n\nتركز اهتماماتي الأكاديمية والمهنية على\n<strong>المدن الذكية، وعلوم البيانات الجغرافية المكانية،\nوالتحليلات الحضرية، واستخدام الذكاء الاصطناعي لدعم القرارات الحضرية</strong>.\n\n</div>\n\n<div class=\"author-facts\">\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">برنامج الدراسات العليا</span>\n<span class=\"fact-value\">MUSA · جامعة بنسلفانيا</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">درجة البكالوريوس</span>\n<span class=\"fact-value\">\nبكالوريوس الهندسة المدنية · جامعة تكساس A&amp;M\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">الخبرة المهنية</span>\n<span class=\"fact-value\">\nWSP · الرياض الخضراء<br>\nBechtel · نيوم\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">الشهادات المهنية</span>\n<span class=\"fact-value\">\nPMP · PMI-RMP · P3O Foundation\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">مجالات الاهتمام</span>\n<span class=\"fact-value\">\nالمدن الذكية · GIS<br>\nالتحليلات الحضرية · الذكاء الاصطناعي\n</span>\n</div>\n\n<div class=\"fact-box\">\n<span class=\"fact-label\">المشروع الحالي</span>\n<span class=\"fact-value\">\nتبريد الرياض\n</span>\n</div>\n\n</div>\n\n</div>\n\n<div class=\"info-card project-card\">\n\n<div class=\"project-heading\">\n\n<h1>تبريد الرياض</h1>\n\n<div class=\"project-subtitle\">\nرسم خرائط الحرارة الحضرية وأولويات التخضير في مدينة الرياض:\nمنهج قائم على علوم البيانات الجغرافية المكانية\n</div>\n\n</div>\n\n<div class=\"project-divider\"></div>\n\n<div class=\"project-description\">\n\nمشروع <strong>تبريد الرياض</strong> هو مشروع في علوم البيانات الجغرافية المكانية\nيدرس العلاقة المكانية بين حرارة سطح الأرض، والغطاء النباتي، والتعرض السكاني،\nوالبيئة المبنية في مدينة الرياض.\n\nيجمع المشروع بين صور الأقمار الصناعية من Landsat، وتقديرات السكان من WorldPop،\nوبصمات المباني من Microsoft، والتحليل المكاني، والتعلم الآلي، والخرائط التفاعلية\nلتحديد المناطق التي قد تستحق مزيدًا من الدراسة عند تقييم تدخلات التخضير الحضري\nوالحد من آثار الحرارة.\n\n</div>\n\n<div class=\"project-tags\">\n\n<span class=\"project-tag\">حرارة سطح الأرض LST</span>\n<span class=\"project-tag\">مؤشر NDVI</span>\n<span class=\"project-tag\">WorldPop</span>\n<span class=\"project-tag\">بصمات المباني</span>\n<span class=\"project-tag\">K-Means</span>\n<span class=\"project-tag\">فحص الأولويات</span>\n\n</div>\n\n<h3 class=\"glance-title\">\nالمشروع في أرقام\n</h3>\n\n<div class=\"glance-grid\">\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4</span>\n<span class=\"glance-label\">مصادر بيانات رئيسية</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">4,700</span>\n<span class=\"glance-label\">خلية تحليل مكانية</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">5</span>\n<span class=\"glance-label\">أنماط حضرية ناتجة عن التجميع</span>\n</div>\n\n<div class=\"glance-card\">\n<span class=\"glance-number\">500 م</span>\n<span class=\"glance-label\">حجم شبكة التحليل المكاني</span>\n</div>\n\n</div>\n\n</div>\n\n</section>\n\n</div>","srcMarkdownNoYaml":"\n\n<style>\n\nhtml,\nbody {\n  direction: rtl;\n}\n\nbody {\n  text-align: right;\n}\n\n.quarto-title-block,\n#title-block-header {\n  display: none !important;\n}\n\n/* =========================================================\n   MAIN WRAPPER\n========================================================= */\n\n.home-wrap {\n  width: min(1380px, 96vw);\n  margin: 0 auto;\n  box-sizing: border-box;\n}\n\n/* =========================================================\n   PAGE TITLE\n========================================================= */\n\n.home-page-title {\n  width: 100%;\n  margin: 2rem auto 1.6rem auto;\n  text-align: center;\n  font-family: \"Tahoma\", \"Arial\", sans-serif;\n  font-size: 2.8rem;\n  line-height: 1.25;\n  font-weight: 700;\n  color: #174D38;\n}\n\n/* =========================================================\n   HERO\n========================================================= */\n\n.hero-section {\n  width